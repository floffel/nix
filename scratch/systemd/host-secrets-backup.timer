[Unit]
Description=Nightly backup of the Proxmox host's shared secrets and LXC configs

[Timer]
# 02:30 local: the restic run in the bucket started at 23:30, so by now a
# fresh host snapshot must exist -- that is exactly what this job verifies.
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15min
# Catch up if the host was down or suspended at 02:30.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
