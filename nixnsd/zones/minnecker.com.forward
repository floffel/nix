_mta-sts                     IN TXT     "v=STSv1; id=2026081501"
_smtp._tls                   IN TXT     "v=TLSRPTv1; rua=mailto:reports@minnecker.com"
; DMARC must live at _dmarc, not on the apex. Reports go to reports@ because
; parsedmarc watches florian's .Reports folder and the routing sieve files
; To/Cc: reports@ there.
_dmarc                       IN TXT     "v=DMARC1; p=reject; sp=reject; rua=mailto:reports@minnecker.com"
mta-sts                      IN CNAME   px
default._bimi                IN TXT     "v=BIMI1; l=https://www.minnecker.com/bimi-logo.svg"


autoconfig               IN CNAME   mail
_autodiscover._tcp       IN SRV     0 100 443 mx.minnecker.com.

@                        IN A       178.63.124.242
@                        IN AAAA    2a01:4f8:fff2:7d::1
px						 IN A		178.63.124.242
px						 IN AAAA	2a01:4f8:fff2:7d::1
; New mail stack entry point (Proxmox host, ports forwarded to nixmail)
mx						300 IN A	178.63.124.242
mx						300 IN AAAA	2a01:4f8:fff2:7d::1
cloud                    IN CNAME  px
riese			 IN A	    157.180.8.210
riese			 IN AAAA    2a01:4f9:3100:312b::2
r			 IN CNAME   px
ns2			 IN A	    78.47.124.81
ns2			 IN AAAA    2a01:4f8:c0c:2ea9::2

www			 IN CNAME  riese

local		0        IN A 127.0.0.1
vault		0	 IN A 10.20.20.14
vault		0	 IN AAAA fd01::14

backendmail		 IN CNAME  px
*			 IN CNAME  px
mail		 IN CNAME  px
; Temporary access to the old Roundcube on riese during/after the MX switch.
; Goes through nginx on px, which proxies to riese with Host mail.minnecker.com.
; Delete this record once the old mailboxes have been migrated.
oldmail		 IN CNAME  px
matrix		 IN CNAME  px
livekit		 IN CNAME  px
kie		 IN CNAME  px
