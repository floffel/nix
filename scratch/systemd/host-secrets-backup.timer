[Unit]
Description=Nightly backup of the Proxmox host's shared secrets and LXC configs

[Timer]
# 02:30 local, well after the 00:00 vzdump window; jitter keeps the NAS off the
# critical path if other nightly jobs drift.
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=15min
# Catch up if the host was down or suspended at 02:30.
Persistent=true
AccuracySec=1min

[Install]
WantedBy=timers.target
