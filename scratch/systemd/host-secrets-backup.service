[Unit]
Description=Back up the Proxmox host's shared secrets and LXC configs
Documentation=file:/root/nixos-config/README.md
# /mnt/pve/nas is pulled in explicitly by the script (it may be idle-unmounted),
# so no RequiresMountsFor here: that would abort the job before the local copy
# is written, and the local copy is the one that survives accidental deletion.
After=local-fs.target network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-host-secrets.sh
# vzdump runs at 00:00; stay out of its way.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min
