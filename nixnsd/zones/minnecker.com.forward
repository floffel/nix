$TTL 7200
@   IN SOA r.floffel.de. postmaster.minnecker.com. (
    2026102001	; serial
    14400       ; refresh
    3600        ; retry
    604800      ; expire
    86400 )     ; minimum

 
@			 IN NS	    r.floffel.de.
@			 IN NS	    ns2.minnecker.com.
@                        IN NS      ns1.first-ns.de.
@                        IN NS      robotns2.second-ns.de.
@                        IN NS      robotns3.second-ns.com.

 
; Lowered TTL (300) for mail cutover; primary = new stack (mx -> px),
; secondary = old server (riese) until the migration is complete.
@                        300 IN MX 10   mx
@                        300 IN MX 20   riese
@                        IN TXT     "v=spf1 a mx -all"

minnecker.com.		 IN CAA	0   issue "letsencrypt.org"

