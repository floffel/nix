_mta-sts                     IN TXT     "v=STSv1; id=2026102101"
_smtp._tls                   IN TXT     "v=TLSRPTv1; rua=mailto:reports@minnecker.com"
; DMARC must live at _dmarc, not on the apex. Reports go to reports@ because
; parsedmarc watches florian's .Reports folder and the routing sieve files
; To/Cc: reports@ there.
_dmarc                       IN TXT     "v=DMARC1; p=reject; sp=reject; rua=mailto:reports@minnecker.com"
mta-sts                      IN CNAME   px
default._bimi                IN TXT     "v=BIMI1; l=https://www.minnecker.com/bimi-logo.svg"


autoconfig               IN CNAME   mail
_autodiscover._tcp       IN SRV     0 100 443 mx.minnecker.com.

@                        IN A       178.63.124.242
@                        IN AAAA    2a01:4f8:fff2:7d::1
px						 IN A		178.63.124.242
px						 IN AAAA	2a01:4f8:fff2:7d::1
; New mail stack entry point (Proxmox host, ports forwarded to nixmail)
mx						300 IN A	178.63.124.242
mx						300 IN AAAA	2a01:4f8:fff2:7d::1
cloud                    IN CNAME  px
r			 IN CNAME   px

; Static site content moved to nixnginx (CT104) — the old server (riese)
; is retired, so www now follows every other service to px.
www			 IN CNAME  px

local		0        IN A 127.0.0.1
vault		0	 IN A 10.20.20.14
vault		0	 IN AAAA fd01::14

backendmail		 IN CNAME  px
; ACME DNS-01 guard. The "*" wildcard below synthesizes a CNAME to px for every
; name that does not exist, and lego follows that CNAME out of this zone — the
; challenge TXT then lands in a zone file that is not served, the challenge
; never goes public and renewal fails silently. A record at this exact name
; stops the wildcard expansion. The value means nothing; keep the record.
_acme-challenge		 300	 IN TXT  "acme-wildcard-guard"
*			 IN CNAME  px
mail		 IN CNAME  px
matrix		 IN CNAME  px
lab		 IN CNAME  px
livekit		 IN CNAME  px
kie		 IN CNAME  px
