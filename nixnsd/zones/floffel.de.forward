$TTL 7200
@   IN SOA r.floffel.de. postmaster.floffel.de. (
    2026081501	; serial
    14400	; refresh
    3600	; retry
    604800	; expire
    86400 )	; minimum
@			 IN NS      r.floffel.de.
@			 IN NS	    ns2.minnecker.com.
@                        IN NS      ns1.first-ns.de.
@                        IN NS      robotns2.second-ns.de.
@                        IN NS      robotns3.second-ns.com.


; Lowered TTL (300) for mail cutover; primary = new stack, secondary = old server.
@                        300 IN MX 10   mx.minnecker.com.
@                        IN TXT     "v=spf1 a mx -all"
_dmarc                   IN TXT     "v=DMARC1; p=reject; sp=reject; rua=mailto:reports@minnecker.com"
minnecker._domainkey     IN TXT     ( "v=DKIM1; k=rsa; " "p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAufuD2ER1rCnOfP5ETij1J3rXiRtpkPx02EwZknPtH79ppP44yZWjqUM7kBgZPfwOcx97d+c63nqWvyY7oYrf5anhQXp39vatAGF1vBpNIhgcQD6IYsgN5rBJyDoX4MUvSYoOTtpE" "NilEa7Zhxc6N/zFmN8gUxRVcoqSsdQMVOh3RafLwg6WWNpyl/02gvElqrg36fh2Rp59Vh8MsQGdNKctA4qM587DRLEgTIWKIAnk6hG7hZd0OPpp3d8btgrwuYqftBZBShoA6rtBrC1F9V1I7fdhOn5kqkUDjth8CDTpuaA8Lve3CNG3FBgOgK52ciboF/vPgfw/XfiU8aVlQwwIDAQAB" )

@                        IN A       178.63.124.242
@                        IN AAAA    2a01:4f8:fff2:7d::1

floffel.de.		 IN CAA 0   issue "letsencrypt.org"

autoconfig               IN CNAME   mail
_autodiscover._tcp       IN SRV     0 100 443 mx.minnecker.com.

r                        IN A	    178.63.124.242 
r			 IN AAAA    2a01:4f8:fff2:7d::1
www                      IN CNAME   r
mail			 IN CNAME   r
