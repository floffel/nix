[Unit]
Description=Back up the Proxmox host's shared secrets and LXC configs
Documentation=https://github.com/floffel/nix
# The job writes a local archive and then only *reads* the Garage bucket to
# confirm the off-host copy is fresh, so it needs no mount and no dependency on
# the nightly S3 run having finished (reading a repository takes no lock).
After=local-fs.target network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/backup-host-secrets.sh
# The nightly restic run starts at 23:30; stay out of its upload window.
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min
